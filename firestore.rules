rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Settings collection
    match /settings/global {
      allow read: if true;
      allow create, update: if isAdmin() && 
        request.resource.data.accessPin is string &&
        request.resource.data.accessPin.size() >= 4 &&
        (request.resource.data.logoUrl == null || request.resource.data.logoUrl is string);
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      // Allow bootstrap admin creation
      allow create: if isSignedIn() && 
                    userId == request.auth.uid && 
                    request.auth.token.email == 'kazih6684@gmail.com' &&
                    request.resource.data.role == 'superadmin';
      allow update, delete: if false; 
    }
  }
}
