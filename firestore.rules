rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'kazih6684@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Settings collection
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      // Allow bootstrap admin creation and update
      allow create, update: if isSignedIn() && 
                    userId == request.auth.uid && 
                    ((request.auth.token.email != null && request.auth.token.email.lower() == 'kazih6684@gmail.com') || isAdmin()) &&
                    request.resource.data.role == 'superadmin';
      allow delete: if false; 
    }
  }
}
